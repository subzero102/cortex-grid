# ==============================================================================
# CORTEX GRID CONSULTING - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env on your Hostinger VPS:
#   cp .env.example .env
# ==============================================================================

# --- [1. Core Server Settings] ---
# Port exposed on the host by Docker Compose (default: 3000)
PORT=3000

# Docker container bind address (must remain 0.0.0.0 inside container)
HOSTNAME=0.0.0.0

# Node environment mode
NODE_ENV=production

# Disable Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1


# --- [2. Canonical Site URL & Metadata] ---
# Used for sitemap.xml, robots.txt, canonical metadata, and OpenGraph social shares
# Replace with your actual domain or VPS IP (e.g., https://cortexgridconsulting.com)
NEXT_PUBLIC_SITE_URL=https://cortexgridconsulting.com


# --- [3. Inbound Consultation Lead Notifications] ---
# Where consultation inquiries should be addressed
CONTACT_NOTIFICATION_EMAIL=alliances@cortexgridconsulting.com

# OPTION A: Hostinger / Custom SMTP (Recommended if you have Hostinger Email or Titan Email)
# Hostinger Business Email settings:
# Host: smtp.hostinger.com | Port: 465 (SSL) or 587 (TLS)
# User: alliances@cortexgridconsulting.com
# Pass: Your email account password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alliances@cortexgridconsulting.com
SMTP_PASS=your_email_password_here
SMTP_FROM="Cortex Grid Inquiries" <alliances@cortexgridconsulting.com>

# OPTION B: Resend Email Service (Alternative: 100 free emails/day)
# If provided, the /api/contact endpoint will send an email via Resend
# Get your free key at: https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Cortex Grid Web" <onboarding@resend.dev>

# OPTION C: Discord / Slack / Webhook Alert
# Paste a Discord webhook URL or Slack incoming webhook URL to receive instant alerts
# LEAD_NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
